// Types.idl — Structures, exceptions et séquences partagées
// Projet : CORBA PDF Server — USSEIN L2 AgroTIC

#ifndef TYPES_IDL
#define TYPES_IDL

module sn {
  module ussein {
    module pdf {

      // ═══ Types de base ═══

      // Représente un fichier PDF sous forme de tableau d'octets
      typedef sequence<octet> PDFData;

      // Liste de PDFs (pour la fusion par exemple)
      typedef sequence<PDFData> PDFList;

      // Liste de numéros de pages
      typedef sequence<long> PageList;

      // Liste de chaines (utilisée par le caviardage textuel)
      typedef sequence<string> StringList;

      // ═══ Résultat standard ═══
      struct PDFResult {
        boolean success;
        PDFData data;       // fichier résultant
        string  message;    // message d'info ou d'erreur
      };

      // ═══ Métadonnées d'un PDF ═══
      struct PDFMetadata {
        string title;
        string author;
        string subject;
        string keywords;
        string creator;
        string producer;
        string creationDate;
        long   pageCount;
      };

      // ═══ Options de compression ═══
      struct CompressOptions {
        boolean compressImages;   // réduire la qualité des images
        long    imageQuality;     // 0-100
        boolean removeMetadata;   // supprimer les métadonnées inutiles
      };

      // ═══ Options de filigrane ═══
      struct WatermarkOptions {
        string  text;             // texte du filigrane
        float   opacity;          // 0.0 à 1.0
        long    fontSize;
        boolean diagonal;         // affichage en diagonale
      };

      // ═══ Options de conversion PDF → Images ═══
      struct ConvertOptions {
        string format;            // "PNG", "JPEG", "TIFF"
        long   dpi;               // résolution (72, 150, 300)
      };

      // ═══ Exceptions ═══

      exception PDFException {
        string code;      // ex: "INVALID_PDF", "PAGE_OUT_OF_RANGE"
        string message;
      };

      exception InvalidPageException {
        long   requestedPage;
        long   totalPages;
        string message;
      };

      exception PasswordException {
        string message;   // PDF déjà protégé, mot de passe incorrect
      };

    }; // pdf
  }; // ussein
}; // sn

#endif