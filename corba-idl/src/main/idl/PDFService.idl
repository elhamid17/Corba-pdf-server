// PDFService.idl — Interface principale du serveur CORBA PDF
// Projet : CORBA PDF Server — USSEIN L2 AgroTIC

#ifndef PDFSERVICE_IDL
#define PDFSERVICE_IDL

#include "Types.idl"

module sn {
  module ussein {
    module pdf {

      interface PDFService {

        // ═══ 1. Fusion ═══
        // Fusionne plusieurs PDFs en un seul dans l'ordre de la liste
        PDFResult merge(in PDFList pdfs)
          raises (PDFException);

        // ═══ 2. Découpage ═══
        // Découpe un PDF en plusieurs à partir d'intervalles de pages
        // ex: ranges = [1,3,4,6] → PDF1(pages 1-3), PDF2(pages 4-6)
        PDFList split(in PDFData pdf, in PageList ranges)
          raises (PDFException, InvalidPageException);

        // ═══ 3. Extraction de pages ═══
        // Extrait les pages spécifiées dans un nouveau PDF
        PDFResult extractPages(in PDFData pdf, in PageList pages)
          raises (PDFException, InvalidPageException);

        // ═══ 4. Suppression de pages ═══
        // Supprime les pages spécifiées et retourne le PDF restant
        PDFResult deletePages(in PDFData pdf, in PageList pages)
          raises (PDFException, InvalidPageException);

        // ═══ 5. Compression ═══
        // Compresse un PDF selon les options fournies
        PDFResult compress(in PDFData pdf, in CompressOptions options)
          raises (PDFException);

        // ═══ 6. Rotation ═══
        // Pivote les pages spécifiées (angle : 90, 180, 270)
        PDFResult rotate(in PDFData pdf, in PageList pages, in long angle)
          raises (PDFException, InvalidPageException);

        // ═══ 7. Filigrane ═══
        // Ajoute un filigrane texte sur toutes les pages
        PDFResult addWatermark(in PDFData pdf, in WatermarkOptions options)
          raises (PDFException);

        // ═══ 8. Mot de passe ═══
        // Protège un PDF avec un mot de passe propriétaire et utilisateur
        PDFResult addPassword(
          in PDFData pdf,
          in string  userPassword,
          in string  ownerPassword
        ) raises (PDFException, PasswordException);

        // ═══ 9. Conversion PDF → Images ═══
        // Convertit chaque page en image, retourne une liste de PDFData (images)
        PDFList convertToImages(in PDFData pdf, in ConvertOptions options)
          raises (PDFException);

        // ═══ 10. Extraction de texte ═══
        // Extrait le texte brut de toutes les pages
        string extractText(in PDFData pdf)
          raises (PDFException);

        // ═══ 11. OCR ═══
        // Reconnaissance optique sur PDF scanné — retourne le texte reconnu
        string performOCR(in PDFData pdf, in string language)
          raises (PDFException);

        // ═══ 12. Signature numérique ═══
        // Signe le PDF avec un certificat PKCS12
        PDFResult sign(
          in PDFData pdf,
          in PDFData certificate,   // fichier .p12 en octets
          in string  password,
          in string  reason,
          in string  location
        ) raises (PDFException);

        // ═══ 13. Métadonnées ═══
        // Lit les métadonnées d'un PDF
        PDFMetadata getMetadata(in PDFData pdf)
          raises (PDFException);

        // Met à jour les métadonnées d'un PDF
        PDFResult setMetadata(in PDFData pdf, in PDFMetadata metadata)
          raises (PDFException);

        // ═══ 14. Création ═══
        // Crée un nouveau PDF à partir d'un texte brut
        PDFResult createFromText(in string text, in string title)
          raises (PDFException);

        // ═══ 15. Conversion PDF → Word (DOCX) ═══
        // Convertit un PDF en document Word (extrait le texte page par page)
        PDFResult pdfToWord(in PDFData pdf)
          raises (PDFException);

        // ═══ 16. Conversion PDF → Excel (XLSX) ═══
        // Convertit un PDF en classeur Excel — une feuille par page,
        // chaque ligne de texte du PDF devient une ligne du tableur
        PDFResult pdfToExcel(in PDFData pdf)
          raises (PDFException);

        // ═══ 17. Conversion Word (DOCX) → PDF ═══
        // Convertit un document Word en PDF
        PDFResult wordToPdf(in PDFData docx)
          raises (PDFException);

        // ═══ 18. Conversion Images → PDF ═══
        // Convertit une ou plusieurs images (JPG/PNG) en un PDF
        // — une page par image
        PDFResult imagesToPdf(in PDFList images)
          raises (PDFException);

        // ═══ 19. Inversion de l'ordre des pages ═══
        // Renverse l'ordre des pages (dernière devient première, etc.)
        PDFResult reversePages(in PDFData pdf)
          raises (PDFException);

        // ═══ 20. Numérotation des pages ═══
        // Ajoute des numéros de page (position : top-left, top-center,
        // top-right, bottom-left, bottom-center, bottom-right)
        // format : "%d", "%d/%d", "Page %d", "Page %d sur %d", ...
        PDFResult addPageNumbers(
          in PDFData pdf,
          in string  position,
          in string  format,
          in long    startNumber,
          in long    fontSize
        ) raises (PDFException);

        // ═══ 21. Redimensionnement des pages ═══
        // Redimensionne toutes les pages vers un format standard
        // targetSize : "A4", "A3", "A5", "LETTER", "LEGAL"
        PDFResult resizePages(in PDFData pdf, in string targetSize)
          raises (PDFException);

        // ═══ 22. Recadrage des pages ═══
        // Recadre toutes les pages en retirant des marges (en pourcentage 0-50)
        PDFResult cropPages(
          in PDFData pdf,
          in float marginLeft,
          in float marginTop,
          in float marginRight,
          in float marginBottom
        ) raises (PDFException);

        // ═══ 23. Page de garde ═══
        // Ajoute une page de garde au début du PDF
        // coverImage : image (PNG/JPEG) qui sera la 1ère page pleine échelle
        PDFResult addCoverPage(in PDFData pdf, in PDFData coverImage)
          raises (PDFException);

        // ═══ 24. Réorganisation des pages ═══
        // Réordonne les pages selon la liste fournie
        // ex: order = [3,1,2] → page 3 devient 1, page 1 devient 2, etc.
        PDFResult reorderPages(in PDFData pdf, in PageList order)
          raises (PDFException, InvalidPageException);

        // ═══ 25. Anonymisation ═══
        // Retire toutes les metadonnees (auteur, titre, dates, producer, etc.)
        PDFResult anonymize(in PDFData pdf)
          raises (PDFException);

        // ═══ 26. Signature manuscrite (image) ═══
        // Appose une image de signature (PNG transparent ou JPG) sur une page
        // position en pourcentage de la page (0-100, origine en bas-gauche)
        // widthPercent : largeur de la signature en % de la largeur de page
        PDFResult addSignatureImage(
          in PDFData pdf,
          in PDFData signatureImage,
          in long page,
          in float xPercent,
          in float yPercent,
          in float widthPercent
        ) raises (PDFException, InvalidPageException);

        // ═══ 27. Caviardage textuel ═══
        // Cherche les termes specifies et les recouvre d'un rectangle noir
        // (le texte sous-jacent reste mais devient illisible visuellement)
        PDFResult redactText(in PDFData pdf, in StringList terms)
          raises (PDFException);

        // ═══ 28. Tampon (stamp) ═══
        // Appose un texte de tampon sur une page (APPROUVE, CONFIDENTIEL, etc.)
        // position : top-left, top-center, top-right, center,
        //            bottom-left, bottom-center, bottom-right
        // color : red, green, blue, black, orange
        PDFResult addStamp(
          in PDFData pdf,
          in string text,
          in long page,
          in string position,
          in string color,
          in long fontSize
        ) raises (PDFException, InvalidPageException);

        // ═══ Utilitaire ═══
        // Retourne le nombre de pages d'un PDF
        long getPageCount(in PDFData pdf)
          raises (PDFException);

        // Vérifie que le serveur est opérationnel
        string ping();

      }; // PDFService

    }; // pdf
  }; // ussein
}; // sn

#endif