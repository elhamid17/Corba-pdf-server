# ════════════════════════════════════════════════════════════════
#  Image Render — mono-service Spring Boot (JVM unique, Java 21)
#  Un seul process java -jar dans un seul conteneur (free tier 512 MB).
# ════════════════════════════════════════════════════════════════

# ── Stage 1 : build du reactor → fat jar api-gateway ────────────
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build

COPY pom.xml ./
COPY pdf-engine ./pdf-engine
COPY api-gateway ./api-gateway
# Settings.xml qui redirige Maven Central vers le miroir Google Cloud
# Storage : evite les .pom corrompus (page HTML Cloudflare au lieu du
# POM reel) servis par Maven Central a l'IP Render.
COPY maven-settings.xml /root/.m2/settings.xml

# Purge le cache au cas ou un .pom HTML corrompu y traine d'un build precedent,
# puis build via le miroir Google. -U force la verification distante.
RUN rm -rf /root/.m2/repository && \
    mvn -B -U -q -s /root/.m2/settings.xml \
        -Dmaven.wagon.http.retryHandler.count=3 \
        clean package -DskipTests

# ── Stage 2 : runtime léger ─────────────────────────────────────
FROM eclipse-temurin:21-jre-alpine

# Tesseract (OCR) + données fra/eng + polices (rendu PDF).
# Les paquets tesseract-ocr-data-* installent dans /usr/share/tessdata/.
RUN apk add --no-cache \
      tesseract-ocr \
      tesseract-ocr-data-fra \
      tesseract-ocr-data-eng \
      fontconfig \
      ttf-dejavu

WORKDIR /app

COPY --from=build /build/api-gateway/target/api-gateway-*.jar /app/api-gateway.jar

# Valeurs par défaut surchargées via render.yaml.
# JVM unique (remplace les deux anciennes) — free tier Render = 512 Mo.
ENV PORT=8080 \
    JAVA_OPTS="-Xmx420m -Xss256k -XX:+UseSerialGC -Djava.security.egd=file:/dev/./urandom" \
    TESSDATA_PATH=/usr/share/tessdata

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -Djava.awt.headless=true -jar /app/api-gateway.jar --server.port=$PORT"]
